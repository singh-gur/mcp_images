# Docker Compose environment for duckduckgo-mcp-server

CONTAINER_NAME=duckduckgo-mcp-server

# Host port exposed by docker compose
HOST_PORT=8000

# MCP server runtime settings
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000

# DuckDuckGo server options
# Allowed values: STRICT, MODERATE, OFF
DDG_SAFE_SEARCH=MODERATE

# Region examples: us-en, uk-en, de-de, fr-fr, jp-ja, cn-zh, wt-wt
DDG_REGION=us-en
